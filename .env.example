# Copy to .env and adjust. Every value here has a working default.

DATABASE_URL=postgres://wealth:wealth@127.0.0.1:5432/wealthcard
TEST_DATABASE_URL=postgres://wealth:wealth@127.0.0.1:5432/wealthcard_test

PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SESSION_TTL_HOURS=12
STEP_UP_TTL_MINUTES=5
AUTH_HOLD_TTL_SECONDS=604800

# Background loops. Raise these when running a long demo so the market does
# not drift underneath you.
RISK_TICK_SECONDS=20
MARKET_TICK_SECONDS=10

# Deterministic market simulator. The same seed replays the same prices.
MARKET_SEED=42

# Optional. Without a key the AI assistant runs deterministic-only, which is
# the production answer path anyway — a model may only rephrase, never compute.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
