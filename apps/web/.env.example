# Where the API is reachable from the browser.
#
# Leave unset in development: Vite proxies /api to http://127.0.0.1:4000.
# Set it for any deployed build — Vite inlines the value at build time, so it
# has to be present when the bundle is built, not when it runs.
#
# VITE_API_BASE_URL=https://your-api-host.example.com
